{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d",
                "build",
                "-sourcepath",
                "src",
                "src/com/motorola6809/simulator/*.java",
                "src/com/motorola6809/view/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$tsc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}








