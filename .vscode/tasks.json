{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d",
                "build",
                "-sourcepath",
                "src",
                "src/com/motorola6809/simulator/*.java",
                "src/com/motorola6809/view/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$tsc"],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "run Simulateur6809",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "build",
                "com.motorola6809.view.Simulateur6809"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "dependsOn": [
                "compile"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}








